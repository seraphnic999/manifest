EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Live flight status (Departures Board "FLTS") — RapidAPI key subscribed to
# AeroDataBox's free tier. Leave unset to leave the feature quietly disabled.
EXPO_PUBLIC_AERODATABOX_KEY=your-rapidapi-key
