{
  "expo": {
    "name": "Manifest",
    "slug": "manifest",
    "scheme": "manifest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#212F3D"
    },
    "ios": { "supportsTablet": false },
    "android": {
      "package": "com.seraphnic999.manifest",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#212F3D"
      }
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Manifest uses your photos to attach pictures to trip items.",
          "cameraPermission": "Manifest uses your camera to attach photos to trip items."
        }
      ],
      "@maplibre/maplibre-react-native"
    ]
  }
}
